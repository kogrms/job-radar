# Copy with scripts/init_env.sh (fills every CHANGEME with a random value). Never commit .env.

# Our services, as seen from the host (inside compose these are overridden to service names).
DATABASE_URL=postgresql+asyncpg://job_radar:job_radar@localhost:5433/job_radar
REDIS_URL=redis://localhost:6380/0

# Langfuse: the same keys are used to provision the project on first start and by the app.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_ADMIN_PASSWORD=CHANGEME
LANGFUSE_SALT=CHANGEME
LANGFUSE_ENCRYPTION_KEY=CHANGEME_HEX64
LANGFUSE_NEXTAUTH_SECRET=CHANGEME
LANGFUSE_PG_PASSWORD=CHANGEME
LANGFUSE_CH_PASSWORD=CHANGEME
LANGFUSE_MINIO_PASSWORD=CHANGEME
LANGFUSE_REDIS_AUTH=CHANGEME

# LLM (worker only). The owner creates the key; prepaid balance with auto-recharge off is the hard spend cap.
OPENAI_API_KEY=

# Private data dir (past decisions, vacancy texts, labels). Leave empty in CI.
PRIVATE_DIR=

# Boards to poll (see examples/boards.yml). BOARDS_FILE is read by local runs; BOARDS_FILE_HOST is mounted
# read-only into the worker container (defaults to the example file).
BOARDS_FILE=
BOARDS_FILE_HOST=
